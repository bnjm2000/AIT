# Copy this file to .env only when the final CSV import is complete.
# Keep the real password out of source control.
DATABASE_URL=postgresql://aim_user:replace-with-password@127.0.0.1:5432/aim_db
DATABASE_POOL_SIZE=10

# Generate a long random value and keep it out of source control.
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret

# Recommended production setup: Waitress serves HTTP locally and an HTTPS
# reverse proxy (IIS, Caddy, or nginx) terminates TLS.
HOST=0.0.0.0
ENABLE_HTTPS=0
PORT=5055
SERVER_BACKEND=waitress
WAITRESS_THREADS=32
WAITRESS_CHANNEL_TIMEOUT=120
# When TLS terminates at a local reverse proxy, keep secure cookies and trust
# only that proxy's forwarded request headers.
EXTERNAL_HTTPS=1
WAITRESS_TRUSTED_PROXY=127.0.0.1
DATA_SIGNATURE_CHECK_INTERVAL_SECONDS=0.75

# Keep mutable company data and uploads outside the application source. On
# Render, attach a persistent disk at /var/data and use /var/data/showbase.
SHOWBASE_STORAGE_ROOT=/var/data/showbase

# Upload/request limits (bytes).
MAX_REQUEST_BYTES=268435456
EVENT_FILE_MAX_BYTES=20971520
MAINTENANCE_IMAGE_MAX_BYTES=10485760
MAINTENANCE_VIDEO_MAX_BYTES=67108864

# Optional Telegram push alerts for successful worker invoice/claim uploads.
# Create a bot with @BotFather, message it once, then obtain the destination
# chat ID from the Bot API getUpdates response. Keep the real token in .env.
TELEGRAM_NOTIFICATIONS_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_SECONDS=5

# Direct HTTPS is intended for local development only. Set
# SERVER_BACKEND=werkzeug and ENABLE_HTTPS=1 to use these certificate paths.
# SSL_CERT_FILE=/path/to/fullchain.pem
# SSL_KEY_FILE=/path/to/privkey.pem
