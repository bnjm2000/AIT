# Copy this file to .env only when the final CSV import is complete.
# Keep the real password out of source control.
DATABASE_URL=postgresql://aim_user:replace-with-password@127.0.0.1:5432/aim_db
DATABASE_POOL_SIZE=10

# Generate a long random value and keep it out of source control.
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret

# Recommended production setup: Waitress serves HTTP locally and an HTTPS
# reverse proxy (IIS, Caddy, or nginx) terminates TLS.
HOST=0.0.0.0
ENABLE_HTTPS=0
PORT=5055
SERVER_BACKEND=waitress
WAITRESS_THREADS=32
WAITRESS_CHANNEL_TIMEOUT=120
DATA_SIGNATURE_CHECK_INTERVAL_SECONDS=0.75

# Upload/request limits (bytes).
MAX_REQUEST_BYTES=268435456
EVENT_FILE_MAX_BYTES=52428800
MAINTENANCE_IMAGE_MAX_BYTES=52428800
MAINTENANCE_VIDEO_MAX_BYTES=262144000

# Direct HTTPS is intended for local development only. Set
# SERVER_BACKEND=werkzeug and ENABLE_HTTPS=1 to use these certificate paths.
# SSL_CERT_FILE=/path/to/fullchain.pem
# SSL_KEY_FILE=/path/to/privkey.pem
